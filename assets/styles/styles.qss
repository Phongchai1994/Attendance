/* ===== Base ===== */
QMainWindow {
    background-color: #DDE3EA;
}

#root {
    background-color: #DDE3EA;
}

QWidget {
    font-family: "Segoe UI", "Noto Sans Thai", sans-serif;
    color: #111827;
}

/* ===== Content Area ===== */
#contentArea {
    background-color: #F8FAFC;
    padding: 24px;
    border-radius: 16px;
}

/* ===== Sidebar ===== */
#sidebar {
    background-color: #f8f9fa;
    padding: 16px;
    border-radius: 16px;
}

#titleLabel {
    color: #000102;
    font-size: 22px;
    font-weight: 700;
    padding: 20px 18px 14px 18px;
    letter-spacing: 0.6px;
}

/* ===== Navigation Button ===== */
QPushButton#navButton {
    background-color: transparent;
    color: #000f20;
    border: none;
    border-radius: 12px;
    text-align: left;
    padding: 12px 16px;
    margin: 0 12px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}

QPushButton#navButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
    border-left: 4px solid #93C5FD;
    padding-left: 12px;
}

QPushButton#navButton:pressed {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

QPushButton#navButton:focus {
    outline: none;
}

QLabel {
    color: #0F172A;
}

/* Optional: Main content labels */
QLabel#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #111827;
}

QLabel#pageSubtitle {
    font-size: 14px;
    color: #64748B;
}

/* ===== Scrollbar ===== */
QScrollBar:vertical {
    background: #E2E8F0;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}